{
  "name": "action-install-gh-release",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Install a GitHub release binary in a GitHub Actions build environment",
  "main": "lib/index.js",
  "scripts": {
    "build": "npm run clean && npm run compile && ncc build .build/main.js -o lib",
    "clean": "node -e \"for (const dir of ['.build', 'lib']) require('node:fs').rmSync(dir, {recursive:true, force:true})\"",
    "compile": "node node_modules/@typescript/native/bin/tsc --outDir .build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src scripts",
    "docs": "node scripts/generate-docs.mjs",
    "test:fuzz": "vitest run src/asset-properties.test.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaxxstorm/action-install-gh-release.git"
  },
  "author": "Lee Briggs",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "hasha": "^7.0.0",
    "lodash": "^4.17.23",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.24",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@actions/cache": {
      "@actions/glob": "0.6.1"
    },
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
